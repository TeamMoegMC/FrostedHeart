+    /** Compares both public paths on the same pageless positions. A negative time marks an unavailable CPU clock. */
+    private static long queryTickingChunks(ServerLevel level, List<LevelChunk> chunks, BlockPos[] positions,
+            boolean useTickingChunk, int repetitions, long[] mismatches) {
+        var clock = java.lang.management.ManagementFactory.getThreadMXBean();
+        boolean timed = clock.isCurrentThreadCpuTimeSupported() && clock.isThreadCpuTimeEnabled();
+        int perChunk = positions.length / chunks.size();
+        long start = timed ? clock.getCurrentThreadCpuTime() : 0;
+        for (int pass = 0; pass < repetitions; pass++) {
+            int i = 0;
+            for (var chunk : chunks) {
+                for (int end = i + perChunk; i < end; i++) {
+                    double value = useTickingChunk
+                            ? MinecraftThermalInput.gameplayPassiveEnvironment(chunk, positions[i], NATURAL_C)
+                            : MinecraftThermalInput.gameplayPassiveEnvironment(level, positions[i], NATURAL_C);
+                    if (value != NATURAL_C) mismatches[0]++;
+                }
+            }
+        }
+        return timed ? clock.getCurrentThreadCpuTime() - start : -1;
+    }
